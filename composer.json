{
  "name": "moca-nz/craft-post-office",
  "description": "A contact form builder for Craft CMS. Build forms in the control panel, store submissions as elements, and send notifications from your own Twig templates.",
  "type": "craft-plugin",
  "license": "MIT",
  "keywords": [
    "craft",
    "craftcms",
    "craft-plugin",
    "forms",
    "contact-form",
    "form-builder"
  ],
  "authors": [
    {
      "name": "MOCA",
      "homepage": "https://www.moca.co.nz/"
    }
  ],
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.5.0"
  },
  "autoload": {
    "psr-4": {
      "moca\\postoffice\\": "src/"
    }
  },
  "support": {
    "source": "https://github.com/MOCA-nz/craft-post-office",
    "issues": "https://github.com/MOCA-nz/craft-post-office/issues",
    "docs": "https://github.com/MOCA-nz/craft-post-office/blob/main/docs/README.md"
  },
  "extra": {
    "name": "Post Office",
    "handle": "post-office",
    "developer": "MOCA",
    "developerUrl": "https://www.moca.co.nz/",
    "documentationUrl": "https://github.com/MOCA-nz/craft-post-office/blob/main/docs/README.md",
    "changelogUrl": "https://raw.githubusercontent.com/MOCA-nz/craft-post-office/main/CHANGELOG.md",
    "class": "moca\\postoffice\\Plugin"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.2",
    "markhuot/craft-pest-core": "^3.2"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --fix --ansi",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  }
}
