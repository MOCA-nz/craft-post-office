{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% do view.registerAssetBundle('moca\\postoffice\\web\\assets\\formbuilder\\FormBuilderAsset') %}

{% set fullPageForm = true %}
{% set crumbs = [{ label: 'Forms'|t('post-office'), url: url('post-office/forms') }] %}

{% set tabs = {
  builder: { label: 'Builder'|t('post-office'), url: '#builder' },
  settings: { label: 'Settings'|t('post-office'), url: '#settings' },
} %}

{% macro fieldSettings(key, field, fieldTypes) %}
  {% import '_includes/forms' as forms %}
  {% set name = 'fields[' ~ key ~ ']' %}

  <div class="post-office-field-settings hidden" data-post-office-field-settings>
    {{ forms.textField({
      label: 'Label'|t('post-office'),
      instructions: 'What the visitor sees above the input.'|t('post-office'),
      name: name ~ '[label]',
      value: field.label ?? '',
      required: true,
      inputAttributes: { 'data-post-office-input': 'label' },
    }) }}

    {{ forms.textField({
      label: 'Handle'|t('post-office'),
      instructions: 'How this field is referenced in templates and email.'|t('post-office'),
      name: name ~ '[handle]',
      value: field.handle ?? '',
      class: 'code',
      required: true,
      inputAttributes: { 'data-post-office-input': 'handle' },
    }) }}

    {{ forms.selectField({
      label: 'Type'|t('post-office'),
      name: name ~ '[type]',
      options: fieldTypes,
      value: field.type ?? 'text',
      inputAttributes: { 'data-post-office-input': 'type' },
    }) }}

    {{ forms.textField({
      label: 'Placeholder'|t('post-office'),
      name: name ~ '[placeholder]',
      value: field.placeholder ?? '',
    }) }}

    {{ forms.textareaField({
      label: 'Options'|t('post-office'),
      instructions: 'One per line, for dropdown, radio and checkbox fields. Use `Label:value` to set a different stored value.'|t('post-office'),
      name: name ~ '[options]',
      rows: 4,
      value: field and field.options is not empty
        ? field.options|map(o => o.label == o.value ? o.label : o.label ~ ':' ~ o.value)|join("\n")
        : '',
    }) }}

    {{ forms.lightswitchField({
      label: 'Required'|t('post-office'),
      name: name ~ '[required]',
      on: field.required ?? false,
    }) }}

    {{ forms.textField({
      label: 'Validation message'|t('post-office'),
      instructions: 'Shown when this field fails validation. Leave blank for the default.'|t('post-office'),
      name: name ~ '[errorMessage]',
      value: field.errorMessage ?? '',
    }) }}

    {{ forms.lightswitchField({
      label: 'Include in email'|t('post-office'),
      instructions: 'Whether this field appears in notification emails.'|t('post-office'),
      name: name ~ '[includeInEmail]',
      on: field.includeInEmail ?? true,
    }) }}
  </div>
{% endmacro %}

{% import _self as builder %}

{% block content %}
  {{ actionInput('post-office/forms/save') }}
  {{ redirectInput('post-office/forms/{id}') }}
  {% if not isNew %}{{ hiddenInput('formId', form.id) }}{% endif %}

  <div id="builder">
    {% if form.getErrors('fields') %}
      <ul class="errors">
        {% for error in form.getErrors('fields') %}
          <li>{{ error }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    <div data-post-office-builder>
      {% if form.fields is empty %}
        <div class="post-office-empty" data-post-office-empty>
          {{ 'No fields yet. Add your first one below.'|t('post-office') }}
        </div>
      {% endif %}

      <ul class="post-office-field-list" data-post-office-field-list>
        {% for field in form.fields %}
          {# A field that has never been saved has no UID yet. It still needs a key of its
             own: `fields[][label]` and `fields[][handle]` are two separate rows to PHP, so an
             empty key splits every field in half on the next save. #}
          {% set rowKey = field.uid ?? 'new' ~ loop.index %}
          <li class="post-office-field" data-post-office-field{{ field.uid is null ? ' data-post-office-new' : '' }}>
            <a class="move icon" title="{{ 'Reorder'|t('post-office') }}"></a>
            <button type="button" class="post-office-field-summary" data-post-office-field-open>
              <span class="post-office-field-label" data-post-office-row-label>{{ field.label }}</span>
              <span class="post-office-field-meta" data-post-office-row-meta>
                {{ field.type }}{% if field.handle %} &middot; {{ field.handle }}{% endif %}
              </span>
            </button>
            <span class="post-office-field-required {{ not field.required ? 'hidden' }}" data-post-office-row-required>*</span>
            {{ builder.fieldSettings(rowKey, field, fieldTypes) }}
          </li>
        {% endfor %}
      </ul>

      <button type="button" class="btn add icon" data-post-office-add-field>
        {{ 'Add a field'|t('post-office') }}
      </button>

      <script type="text/template" data-post-office-field-prototype>
        <li class="post-office-field" data-post-office-field data-post-office-new>
          <a class="move icon" title="{{ 'Reorder'|t('post-office') }}"></a>
          <button type="button" class="post-office-field-summary" data-post-office-field-open>
            <span class="post-office-field-label" data-post-office-row-label>{{ 'Untitled field'|t('post-office') }}</span>
            <span class="post-office-field-meta" data-post-office-row-meta>{{ 'Text'|t('post-office') }}</span>
          </button>
          <span class="post-office-field-required hidden" data-post-office-row-required>*</span>
          {{ builder.fieldSettings('__ROW__', null, fieldTypes) }}
        </li>
      </script>
    </div>
  </div>

  <div id="settings" class="hidden">
    {# Explicit IDs: Craft generates a random one per field otherwise, and the handle
       generator below needs to be able to find these two. #}
    {{ forms.textField({
      first: true,
      id: 'form-name',
      label: 'Name'|t('post-office'),
      name: 'name',
      value: form.name,
      required: true,
      errors: form.getErrors('name'),
    }) }}

    {{ forms.textField({
      id: 'form-handle',
      label: 'Handle'|t('post-office'),
      name: 'handle',
      value: form.handle,
      class: 'code',
      required: true,
      errors: form.getErrors('handle'),
    }) }}

    <hr>

    {{ forms.autosuggestField({
      label: 'From name'|t('post-office'),
      instructions: 'Leave blank to use the system default.'|t('post-office'),
      name: 'fromName',
      value: form.fromName,
      suggestEnvVars: true,
    }) }}

    {{ forms.autosuggestField({
      label: 'From email'|t('post-office'),
      instructions: 'Leave blank to use the system default.'|t('post-office'),
      name: 'fromEmail',
      value: form.fromEmail,
      suggestEnvVars: true,
      errors: form.getErrors('fromEmail'),
    }) }}

    {{ forms.autosuggestField({
      label: 'Reply-To'|t('post-office'),
      instructions: 'Leave blank to reply to the submitter’s own email field.'|t('post-office'),
      name: 'replyToEmail',
      value: form.replyToEmail,
      suggestEnvVars: true,
      errors: form.getErrors('replyToEmail'),
    }) }}

    <hr>

    {{ forms.selectField({
      label: 'On success'|t('post-office'),
      name: 'successBehavior',
      options: [
        { label: 'Redirect'|t('post-office'), value: 'redirect' },
        { label: 'No reload (JS fetch)'|t('post-office'), value: 'ajax' },
      ],
      value: form.successBehavior,
      toggle: true,
      targetPrefix: 'success-',
    }) }}

    <div id="success-redirect" class="{{ form.successBehavior != 'redirect' ? 'hidden' }}">
      {{ forms.textField({
        label: 'Redirect URL'|t('post-office'),
        name: 'redirectUrl',
        value: form.redirectUrl,
        errors: form.getErrors('redirectUrl'),
      }) }}
    </div>

    {{ forms.textareaField({
      label: 'Success message'|t('post-office'),
      instructions: 'Shown after a successful submission, and returned in the JSON response.'|t('post-office'),
      name: 'formSuccessMessage',
      value: form.successMessage,
      rows: 2,
    }) }}

    <hr>

    <h2>{{ 'Notifications'|t('post-office') }}</h2>

    {% set notificationRows = {} %}
    {% for n in form.notifications|filter(n => not n.isAutoresponder) %}
      {% set notificationRows = notificationRows|merge({
        (n.uid): { recipientEmail: n.recipientEmail, subject: n.subject, templatePath: n.templatePath, enabled: n.enabled },
      }) %}
    {% endfor %}

    {{ forms.editableTableField({
      label: 'Send to'|t('post-office'),
      instructions: 'Each row is one email, with its own template. Recipient and Subject accept a field reference like `{{ agent }}`, resolved per submission. Only select, radio, checkboxes and email fields may decide a recipient.'|t('post-office'),
      name: 'notifications',
      cols: {
        recipientEmail: { type: 'singleline', heading: 'Recipient'|t('post-office'), placeholder: 'name@example.com' },
        subject: { type: 'singleline', heading: 'Subject'|t('post-office'), placeholder: 'New enquiry' },
        templatePath: { type: 'singleline', heading: 'Email template'|t('post-office'), code: true, placeholder: '_emails/enquiry' },
        enabled: { type: 'lightswitch', heading: 'Enabled'|t('post-office') },
      },
      rows: notificationRows,
      addRowLabel: 'Add a recipient'|t('post-office'),
      allowAdd: true,
      allowDelete: true,
      allowReorder: true,
    }) }}

    {% set autoresponder = form.notifications|filter(n => n.isAutoresponder)|first %}

    <h3>{{ 'Reply to the submitter'|t('post-office') }}</h3>

    {{ forms.lightswitchField({
      label: 'Send a copy to the submitter'|t('post-office'),
      instructions: 'Sends to the form’s own email field. Always listed, never deleted.'|t('post-office'),
      name: 'autoresponderEnabled',
      on: autoresponder ? autoresponder.enabled : false,
    }) }}

    {{ forms.textField({
      label: 'Subject'|t('post-office'),
      instructions: 'Leave blank for “Thanks for getting in touch”.'|t('post-office'),
      name: 'autoresponderSubject',
      value: autoresponder ? autoresponder.subject : '',
    }) }}

    {{ forms.textField({
      label: 'Email template'|t('post-office'),
      name: 'autoresponderTemplate',
      class: 'code',
      placeholder: '_emails/confirmation',
      value: autoresponder ? autoresponder.templatePath : '',
    }) }}

    <hr>

    <h2>{{ 'Spam protection'|t('post-office') }}</h2>

    {{ forms.lightswitchField({
      label: 'Honeypot'|t('post-office'),
      instructions: 'Adds a hidden field bots fill in, plus a minimum time-to-submit check.'|t('post-office'),
      name: 'honeypotEnabled',
      on: form.honeypotEnabled,
    }) }}

    {# Only offered once it is switched on and configured plugin-wide. A form that already
       has one turned on keeps that setting: the switch is hidden, not posted, and the save
       leaves the stored value alone. #}
    {% if recaptchaUsable %}
      {{ forms.lightswitchField({
        label: 'reCAPTCHA'|t('post-office'),
        name: 'recaptchaEnabled',
        on: form.recaptchaEnabled,
      }) }}
    {% endif %}

    {% if turnstileUsable %}
      {{ forms.lightswitchField({
        label: 'Turnstile'|t('post-office'),
        name: 'turnstileEnabled',
        on: form.turnstileEnabled,
      }) }}
    {% endif %}

    {% if not recaptchaUsable and not turnstileUsable %}
      <p class="light">
        {{ 'reCAPTCHA and Turnstile are switched off for this site. Turn one on in the plugin settings to offer it here.'|t('post-office') }}
      </p>
    {% endif %}
  </div>
{% endblock %}

{% js %}
  new Craft.PostOfficeFormBuilder($('[data-post-office-builder]'));

  // Derive the form's handle from its name, the way the fields do, and the way every other
  // Craft screen does. The generator stops as soon as the handle is edited by hand, and
  // never touches a handle that already has a value, so an existing form is safe.
  new Craft.HandleGenerator('#form-name', '#form-handle');
{% endjs %}
