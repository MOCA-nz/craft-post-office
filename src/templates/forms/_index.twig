{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = 'Forms'|t('post-office') %}

{% block actionButton %}
  <a href="{{ url('post-office/forms/new') }}" class="btn submit add icon">{{ 'New form'|t('post-office') }}</a>
{% endblock %}

{% block content %}
  {% if forms is empty %}
    <p>{{ 'No forms yet.'|t('post-office') }}</p>
  {% else %}
    <table class="data fullwidth">
      <thead>
        <tr>
          <th scope="col">{{ 'Name'|t('post-office') }}</th>
          <th scope="col">{{ 'Handle'|t('post-office') }}</th>
          <th scope="col">{{ 'Fields'|t('post-office') }}</th>
          <th scope="col">{{ 'Submissions'|t('post-office') }}</th>
          <td class="thin"></td>
        </tr>
      </thead>
      <tbody>
        {% for form in forms %}
          <tr>
            <th scope="row" data-title="{{ 'Name'|t('post-office') }}">
              <a href="{{ url('post-office/forms/' ~ form.id) }}">{{ form.name }}</a>
            </th>
            <td data-title="{{ 'Handle'|t('post-office') }}"><code>{{ form.handle }}</code></td>
            <td data-title="{{ 'Fields'|t('post-office') }}">{{ form.fields|length }}</td>
            <td data-title="{{ 'Submissions'|t('post-office') }}">
              <a href="{{ url('post-office/submissions', { source: 'form:' ~ form.handle }) }}">
                {{ craft.postOffice.submissionCount(form.id) }}
              </a>
            </td>
            <td class="thin">
              <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('post-office/forms/delete') }}
                {{ hiddenInput('id', form.id) }}
                <button type="submit" class="delete icon" title="{{ 'Delete'|t('post-office') }}"></button>
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
{% endblock %}
