{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = 'Post Office Settings'|t('post-office') %}
{% set fullPageForm = not readOnly %}
{% set crumbs = [{ label: 'Post Office'|t('post-office'), url: url('post-office/forms') }] %}

{% block content %}
  {{ actionInput('post-office/settings/save') }}

  <p class="light">
    {{ 'Keys are stored in project config, so give each one an environment variable reference rather than the key itself. Which of these run is set per form, on the form’s Settings tab.'|t('post-office') }}
  </p>

  <h2>{{ 'History'|t('post-office') }}</h2>

  {{ forms.textField({
    label: 'Keep history for'|t('post-office'),
    instructions: 'How many days of sent notifications and log entries to keep. Craft’s garbage collection removes anything older. Set to 0 to keep everything forever.'|t('post-office'),
    name: 'historyRetentionDays',
    value: settings.historyRetentionDays,
    type: 'number',
    size: 5,
    unit: 'days'|t('post-office'),
    disabled: readOnly,
    errors: settings.getErrors('historyRetentionDays'),
  }) }}

  <hr>

  <h2>{{ 'reCAPTCHA'|t('post-office') }}</h2>

  {{ forms.lightswitchField({
    label: 'Use reCAPTCHA'|t('post-office'),
    instructions: 'Off means no form can turn it on.'|t('post-office'),
    name: 'recaptchaEnabled',
    on: settings.recaptchaEnabled,
    disabled: readOnly,
    toggle: 'recaptcha-keys',
  }) }}

  <div id="recaptcha-keys" class="{{ not settings.recaptchaEnabled ? 'hidden' }}">
    {{ forms.autosuggestField({
      label: 'Site key'|t('post-office'),
      name: 'recaptchaSiteKey',
      value: settings.recaptchaSiteKey,
      suggestEnvVars: true,
      disabled: readOnly,
    }) }}

    {{ forms.autosuggestField({
      label: 'Secret key'|t('post-office'),
      name: 'recaptchaSecretKey',
      value: settings.recaptchaSecretKey,
      suggestEnvVars: true,
      disabled: readOnly,
    }) }}
  </div>

  <hr>

  <h2>{{ 'Turnstile'|t('post-office') }}</h2>

  {{ forms.lightswitchField({
    label: 'Use Turnstile'|t('post-office'),
    instructions: 'Off means no form can turn it on.'|t('post-office'),
    name: 'turnstileEnabled',
    on: settings.turnstileEnabled,
    disabled: readOnly,
    toggle: 'turnstile-keys',
  }) }}

  <div id="turnstile-keys" class="{{ not settings.turnstileEnabled ? 'hidden' }}">
    {{ forms.autosuggestField({
      label: 'Site key'|t('post-office'),
      name: 'turnstileSiteKey',
      value: settings.turnstileSiteKey,
      suggestEnvVars: true,
      disabled: readOnly,
    }) }}

    {{ forms.autosuggestField({
      label: 'Secret key'|t('post-office'),
      name: 'turnstileSecretKey',
      value: settings.turnstileSecretKey,
      suggestEnvVars: true,
      disabled: readOnly,
    }) }}
  </div>

  {% if readOnly %}
    <p class="warning">
      {{ 'Administrative changes are disabled in this environment.'|t('post-office') }}
    </p>
  {% endif %}
{% endblock %}
