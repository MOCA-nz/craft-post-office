{#
  Renders a whole form.

  Override by copying this file to templates/post-office/_form.twig in your project. Everything
  it relies on is passed in, so an override can restructure the markup freely.
#}
{% set submission = postOfficeSubmission ?? null %}
{% set values = submission ? submission.values : {} %}
{% set errors = submission ? submission.fieldErrors : {} %}
{% set isAjax = form.successBehavior == 'ajax' %}

<form method="post"
      accept-charset="UTF-8"
      class="post-office-form"
      data-post-office-form="{{ form.handle }}"
      {% if isAjax %}data-post-office-ajax{% endif %}>
  {{ csrfInput() }}
  {{ actionInput('post-office/submit') }}
  {{ hiddenInput('formHandle', form.handle) }}

  {% if form.honeypotEnabled %}
    {# Bots fill anything they find. Hidden from people, and from screen readers. #}
    <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden">
      <label>{{ 'Leave this field empty'|t('post-office') }}
        <input type="text" name="{{ honeypotField }}" value="" tabindex="-1" autocomplete="off">
      </label>
    </div>
    <input type="hidden" name="{{ timestampField }}" value="{{ timestamp }}">
  {% endif %}

  <div class="post-office-message" data-post-office-message hidden></div>

  {% for field in form.fields %}
    {% include 'post-office/_field' with {
      form: form,
      field: field,
      values: values,
      errors: errors,
    } only %}
  {% endfor %}

  <button type="submit" class="post-office-submit">{{ 'Send'|t('post-office') }}</button>
</form>

{% if isAjax %}
  {% js %}
    (function () {
      var form = document.querySelector('[data-post-office-form="{{ form.handle }}"][data-post-office-ajax]');
      if (!form || form.dataset.postOfficeBound) return;
      form.dataset.postOfficeBound = '1';

      var message = form.querySelector('[data-post-office-message]');
      var button = form.querySelector('[type=submit]');

      function clearErrors() {
        form.querySelectorAll('[data-post-office-error]').forEach(function (el) {
          el.textContent = '';
          el.hidden = true;
          var wrap = el.closest('.post-office-field');
          if (wrap) wrap.classList.remove('post-office-field--error');
        });
      }

      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        clearErrors();
        button.disabled = true;

        // Not form.action: Craft's actionInput() emits <input name="action">, and a named
        // form control shadows the form's own action property, so form.action returns that
        // input element rather than a URL. The form posts to the current page anyway.
        fetch(form.getAttribute('action') || window.location.href, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            message.hidden = false;
            message.textContent = data.message || '';
            message.className = 'post-office-message post-office-message--' + (data.success ? 'success' : 'error');

            if (data.success) {
              form.reset();
              return;
            }

            Object.keys(data.errors || {}).forEach(function (handle) {
              var el = form.querySelector('[data-post-office-error="' + handle + '"]');
              if (!el) return;
              el.textContent = data.errors[handle][0];
              el.hidden = false;
              var wrap = el.closest('.post-office-field');
              if (wrap) wrap.classList.add('post-office-field--error');
            });
          })
          .catch(function () {
            message.hidden = false;
            message.className = 'post-office-message post-office-message--error';
            message.textContent = '{{ 'Something went wrong. Please try again.'|t('post-office') }}';
          })
          .finally(function () { button.disabled = false; });
      });
    })();
  {% endjs %}
{% endif %}
