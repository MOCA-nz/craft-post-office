{% extends '_layouts/cp' %}

{% set title = submission.uiLabel %}
{% set crumbs = [
  { label: 'Submissions'|t('post-office'), url: url('post-office/submissions') },
] %}

{% block content %}
  <table class="data fullwidth">
    <tbody>
      {% for row in submission.displayValues %}
        <tr>
          <th scope="row" style="width: 30%;">{{ row.label }}</th>
          <td>{{ row.value is empty ? '—' : row.value|nl2br }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2 style="margin-top: 24px;">{{ 'Notifications sent'|t('post-office') }}</h2>

  {% if sent is empty %}
    <p class="light">{{ 'No notifications were sent for this submission.'|t('post-office') }}</p>
  {% else %}
    <table class="data fullwidth">
      <thead>
        <tr>
          <th scope="col">{{ 'Recipient'|t('post-office') }}</th>
          <th scope="col">{{ 'Status'|t('post-office') }}</th>
          <th scope="col">{{ 'Sent'|t('post-office') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for row in sent %}
          <tr>
            <td>{{ row.recipientEmail }}</td>
            <td>
              <span class="status {{ row.status == 'sent' ? 'live' : 'off' }}"></span>
              {{ row.status|title }}
              {%- if row.error %} <span class="error">{{ row.error }}</span>{% endif %}
            </td>
            <td>{{ row.dateCreated|datetime('short') }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
{% endblock %}

{% block details %}
  <div class="meta read-only">
    <div class="data">
      <h5 class="heading">{{ 'Form'|t('post-office') }}</h5>
      <div class="value">
        {%- if form -%}
          <a href="{{ url('post-office/forms/' ~ form.id) }}">{{ form.name }}</a>
        {%- else -%}
          {{ 'Deleted'|t('post-office') }}
        {%- endif -%}
      </div>
    </div>
    <div class="data">
      <h5 class="heading">{{ 'Date Submitted'|t('post-office') }}</h5>
      <div class="value">{{ submission.dateCreated|datetime('short') }}</div>
    </div>
    <div class="data">
      <h5 class="heading">{{ 'IP address'|t('post-office') }}</h5>
      <div class="value">{{ submission.ipAddress ?: '—' }}</div>
    </div>
  </div>
{% endblock %}
